{
    "hooks": {
        "SessionStart": [
            {
                "matcher": "compact",
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun \"${PLUGIN_ROOT}/scripts/codex.ts\"",
                        "commandWindows": "powershell -NoProfile -NonInteractive -Command \"& bun (Join-Path $env:PLUGIN_ROOT 'scripts/codex.ts')\"",
                        "additionalContextLimit": 0
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun \"${PLUGIN_ROOT}/scripts/codex.ts\"",
                        "commandWindows": "powershell -NoProfile -NonInteractive -Command \"& bun (Join-Path $env:PLUGIN_ROOT 'scripts/codex.ts')\"",
                        "additionalContextLimit": 0
                    }
                ]
            }
        ],
        "SubagentStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "bun \"${PLUGIN_ROOT}/scripts/codex.ts\"",
                        "commandWindows": "powershell -NoProfile -NonInteractive -Command \"& bun (Join-Path $env:PLUGIN_ROOT 'scripts/codex.ts')\"",
                        "additionalContextLimit": 0
                    }
                ]
            }
        ]
    }
}
